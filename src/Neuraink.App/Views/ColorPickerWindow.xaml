<Window x:Class="Neuraink.App.Views.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Color.Title}" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
    <Window.Resources>
        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="4" Background="{TemplateBinding Background}" BorderThickness="1"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter TargetName="B" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </Window.Resources>

    <Grid Margin="20" FlowDirection="LeftToRight">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- saturation / value square + hue bar -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
            <Grid x:Name="SvArea" Width="240" Height="240" ClipToBounds="True" Cursor="Cross"
                  MouseLeftButtonDown="OnSvDown" MouseMove="OnSvMove" MouseLeftButtonUp="OnSvUp">
                <Border x:Name="HueFill" CornerRadius="6" Background="Red" />
                <Border CornerRadius="6">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFFFFFFF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border CornerRadius="6">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#FF000000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Canvas IsHitTestVisible="False">
                    <Ellipse x:Name="SvThumb" Width="16" Height="16" Stroke="White" StrokeThickness="2">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.8" />
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>
            </Grid>
            <Grid x:Name="HueArea" Width="20" Height="240" Margin="14,0,0,0" Cursor="Hand"
                  MouseLeftButtonDown="OnHueDown" MouseMove="OnHueMove" MouseLeftButtonUp="OnHueUp">
                <Border CornerRadius="10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FF0000" Offset="0" />
                            <GradientStop Color="#FFFF00" Offset="0.1667" />
                            <GradientStop Color="#00FF00" Offset="0.3333" />
                            <GradientStop Color="#00FFFF" Offset="0.5" />
                            <GradientStop Color="#0000FF" Offset="0.6667" />
                            <GradientStop Color="#FF00FF" Offset="0.8333" />
                            <GradientStop Color="#FF0000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Canvas IsHitTestVisible="False">
                    <Border x:Name="HueThumb" Width="26" Height="8" Canvas.Left="-3" CornerRadius="4" BorderBrush="White" BorderThickness="2">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.8" />
                        </Border.Effect>
                    </Border>
                </Canvas>
            </Grid>
        </StackPanel>

        <!-- values, preview, swatches -->
        <StackPanel Grid.Column="2" Width="262">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="HEX" Style="{StaticResource Caption}" />
                    <TextBox x:Name="HexBox" FontFamily="Consolas" FontSize="15" MaxLength="9" VerticalContentAlignment="Center"
                             TextChanged="OnHexChanged" LostFocus="OnHexLostFocus" />
                </StackPanel>
                <!-- new (top) / current (bottom) -->
                <Border Grid.Column="2" Width="72" CornerRadius="6" BorderThickness="1" ClipToBounds="True" VerticalAlignment="Bottom" Height="54"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Border x:Name="NewPreview" CornerRadius="5,5,0,0" ToolTip="{DynamicResource Color.New}" />
                        <Border x:Name="OldPreview" Grid.Row="1" CornerRadius="0,0,5,5" ToolTip="{DynamicResource Color.Current}" Cursor="Hand"
                                MouseLeftButtonDown="OnOldClick" />
                    </Grid>
                </Border>
            </Grid>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="R" Style="{StaticResource Caption}" />
                    <TextBox x:Name="RBox" TextChanged="OnRgbChanged" MaxLength="3" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="G" Style="{StaticResource Caption}" />
                    <TextBox x:Name="GBox" TextChanged="OnRgbChanged" MaxLength="3" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="B" Style="{StaticResource Caption}" />
                    <TextBox x:Name="BBox" TextChanged="OnRgbChanged" MaxLength="3" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{DynamicResource Color.Palette}" Style="{StaticResource Caption}" Margin="0,16,0,6" />
            <ItemsControl x:Name="PaletteList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Width="262" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource Swatch}" Background="{Binding Brush}" ToolTip="{Binding Hex}" Click="OnSwatchClick" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel x:Name="RecentPanel">
                <TextBlock Text="{DynamicResource Color.Recent}" Style="{StaticResource Caption}" Margin="0,8,0,6" />
                <ItemsControl x:Name="RecentList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Swatch}" Background="{Binding Brush}" ToolTip="{Binding Hex}" Click="OnSwatchClick" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="OkButton" Content="{DynamicResource Common.OK}" MinWidth="110" Padding="0,7" IsDefault="True"
                    Style="{DynamicResource AccentButtonStyle}" Click="OnOk" />
            <Button Content="{DynamicResource Common.Cancel}" MinWidth="110" Padding="0,7" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
