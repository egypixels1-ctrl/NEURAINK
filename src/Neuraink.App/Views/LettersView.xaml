<UserControl x:Class="Neuraink.App.Views.LettersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <!-- ============ all letters ============ -->
        <DockPanel>
            <DockPanel.Style>
                <Style TargetType="DockPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Selected}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DockPanel.Style>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <TextBlock Text="{DynamicResource Nav.Letters}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{DynamicResource Let.Sub}" Style="{StaticResource Muted}" />
            </StackPanel>
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Cards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.ShowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                        Template="{StaticResource BareButton}" Cursor="Hand" Margin="0,0,14,14">
                                    <Border x:Name="Card" Width="268" Style="{StaticResource Card}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,10">
                                                <Border Width="58" Height="58" CornerRadius="12" Background="{DynamicResource BrandSoftBrush}" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Letter}" FontSize="34" Foreground="{DynamicResource BrandBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Count}" FontSize="22" FontWeight="Bold" />
                                                    <TextBlock Text="{DynamicResource Let.Pieces}" Style="{StaticResource Muted}" FontSize="12" />
                                                </StackPanel>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Forms}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,8" />
                                            <ItemsControl ItemsSource="{Binding Samples}" Height="44">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><UniformGrid Columns="6" Rows="1" /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{StaticResource PaperBrush}" CornerRadius="6" Margin="0,0,4,0" Padding="3">
                                                            <Image Source="{Binding}" RenderOptions.BitmapScalingMode="HighQuality" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <ProgressBar Value="{Binding Percent}" Style="{StaticResource SlimBar}" Margin="0,12,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Button>
                                <DataTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource BrandBrush}" />
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8D2;" FontSize="40" HorizontalAlignment="Center" Opacity="0.5" Margin="0,0,0,12" />
                    <TextBlock Text="{DynamicResource Let.Empty}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Let.EmptyHint}" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,4,0,16" />
                    <Button Command="{Binding StartCommand}" Content="{DynamicResource Dash.Continue}" Style="{DynamicResource AccentButtonStyle}" HorizontalAlignment="Center" Padding="16,7" />
                </StackPanel>
            </Grid>
        </DockPanel>

        <!-- ============ one letter ============ -->
        <DockPanel Visibility="{Binding Selected, Converter={StaticResource NonEmptyToVis}}">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Command="{Binding BackCommand}" VerticalAlignment="Center" Padding="12,7">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72B;" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource Let.Back}" />
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Selected.Letter}" FontSize="44" FontWeight="SemiBold" Foreground="{DynamicResource BrandBrush}" Margin="0,0,16,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="18" FontWeight="SemiBold"><Run Text="{Binding Selected.Count, Mode=OneWay}" /> <Run Text="{DynamicResource Let.Pieces}" /></TextBlock>
                        <TextBlock Text="{Binding Selected.Forms}" Style="{StaticResource Muted}" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Detail}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="132" Height="132" Background="{StaticResource PaperBrush}" CornerRadius="10" Margin="0,0,10,10" Padding="10"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <Image Source="{Binding}" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
