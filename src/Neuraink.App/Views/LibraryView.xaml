<UserControl x:Class="Neuraink.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" FocusVisualStyle="{x:Null}" AllowDrop="True">
    <DockPanel>
        <!-- header: title, count; Add pieces (pictures: pure black on white, the file name is the text) -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding BusyText}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <Button Command="{Binding AddCommand}" Style="{DynamicResource AccentButtonStyle}" Padding="14,7" ToolTip="{DynamicResource Lib.AddTip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource Lib.Add}" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{DynamicResource Nav.Library}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding CountText}" Style="{StaticResource Muted}" />
            </StackPanel>
        </DockPanel>

        <!-- toolbar -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,14" Orientation="Horizontal">
            <Grid Width="320" Margin="0,0,12,6">
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}" Padding="34,6,10,6" VerticalContentAlignment="Center" />
                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13" Margin="12,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False" Opacity="0.6" />
                <TextBlock Text="{DynamicResource Lib.Search}" Margin="36,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.5">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Search}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <Border Style="{StaticResource Card}" Padding="10,4" Margin="0,0,12,6" CornerRadius="8">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="{DynamicResource Lib.All}" GroupName="libf" Margin="0,0,14,0" MinWidth="0"
                                 IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=all}" />
                    <RadioButton Content="{DynamicResource Lib.Todo}" GroupName="libf" Margin="0,0,14,0" MinWidth="0"
                                 IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=todo}" />
                    <RadioButton Content="{DynamicResource Lib.Done}" GroupName="libf" Margin="0,0,14,0" MinWidth="0"
                                 IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=done}" />
                    <RadioButton Content="{DynamicResource Lib.Rejected}" GroupName="libf" MinWidth="0"
                                 IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=rejected}" />
                </StackPanel>
            </Border>
            <CheckBox Content="{DynamicResource Lib.Single}" IsChecked="{Binding SingleWord}" Margin="0,0,12,6" VerticalAlignment="Center" />
            <ComboBox SelectedIndex="{Binding SortIndex}" Width="170" Margin="0,0,12,6" VerticalAlignment="Center">
                <ComboBoxItem Content="{DynamicResource Lib.SortFreq}" />
                <ComboBoxItem Content="{DynamicResource Lib.SortBest}" />
                <ComboBoxItem Content="{DynamicResource Lib.SortFile}" />
                <ComboBoxItem Content="{DynamicResource Lib.SortNew}" />
            </ComboBox>
            <!-- ticked pieces: remove them together -->
            <Border Style="{StaticResource Card}" Padding="12,4,4,4" Margin="0,0,0,6" CornerRadius="8" BorderBrush="{DynamicResource BrandBrush}"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding SelectedText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Command="{Binding DeleteCommand}" Padding="10,4" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="12" Margin="0,0,6,0" Foreground="{StaticResource BadBrush}" />
                            <TextBlock Text="{DynamicResource Lib.Delete}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ClearSelectionCommand}" Padding="8,4" ToolTip="{DynamicResource Lib.ClearSel}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="11" />
                    </Button>
                </StackPanel>
            </Border>
        </WrapPanel>

        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Tiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                        Template="{StaticResource BareButton}" Cursor="Hand" Margin="0,0,12,12" MouseDown="OnTileMouseDown">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{DynamicResource Lib.Open}" Click="OnMenuOpen" />
                                            <MenuItem Header="{DynamicResource Lib.OpenNewTab}" Click="OnMenuOpenNewTab" InputGestureText="Ctrl+Click" />
                                            <MenuItem Header="{DynamicResource Lib.Select}" Click="OnMenuSelect" />
                                            <Separator />
                                            <MenuItem Header="{DynamicResource Lib.Delete}" Click="OnMenuDelete" InputGestureText="Delete">
                                                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="13" Foreground="{StaticResource BadBrush}" /></MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <Border x:Name="Tile" Width="176" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                                        <StackPanel>
                                            <Grid Height="160" Background="{StaticResource PaperBrush}">
                                                <Image Source="{Binding Image}" Margin="12" RenderOptions.BitmapScalingMode="HighQuality" />
                                                <!-- tick: several pieces can be removed at once -->
                                                <CheckBox x:Name="Tick" IsChecked="{Binding IsSelected}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,2,0"
                                                          MinWidth="0" Focusable="False" Cursor="Hand" Visibility="Hidden" ToolTip="{DynamicResource Lib.Select}" />
                                                <Border Style="{StaticResource Pill}" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource BrandBrush}" BorderThickness="0"
                                                        Visibility="{Binding IsBest, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE735;" FontSize="10" Foreground="White" />
                                                </Border>
                                            </Grid>
                                            <DockPanel Margin="10,8">
                                                <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" x:Name="BadgeBox">
                                                    <TextBlock Text="{Binding Badge}" FontSize="10.5" x:Name="BadgeText" />
                                                </Border>
                                                <TextBlock Text="{Binding Text}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FlowDirection="RightToLeft" HorizontalAlignment="Left" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                        <Setter TargetName="BadgeBox" Property="BorderBrush" Value="{StaticResource GoodBrush}" />
                                        <Setter TargetName="BadgeText" Property="Foreground" Value="{StaticResource GoodBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsRejected}" Value="True">
                                        <Setter TargetName="BadgeBox" Property="BorderBrush" Value="{StaticResource BadBrush}" />
                                        <Setter TargetName="BadgeText" Property="Foreground" Value="{StaticResource BadBrush}" />
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource BrandBrush}" />
                                        <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                        <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource BrandBrush}" />
                                        <Setter TargetName="Tile" Property="BorderThickness" Value="2" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="{DynamicResource Lib.More}" Command="{Binding LoadMoreCommand}" HorizontalAlignment="Center" Margin="0,8,0,16" Padding="18,7"
                            Visibility="{Binding HasMore, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </ScrollViewer>
            <TextBlock Text="{DynamicResource Lib.Empty}" Style="{StaticResource Muted}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding LibraryMissing, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{DynamicResource Dash.NoLib}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="{DynamicResource Dash.NoLibHint}" Style="{StaticResource Muted}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
