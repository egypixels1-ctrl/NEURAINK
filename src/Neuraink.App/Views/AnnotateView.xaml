<UserControl x:Class="Neuraink.App.Views.AnnotateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" FocusVisualStyle="{x:Null}">
    <UserControl.Resources>
        <!-- buttons of the tool bar (Illustrator style: a tall narrow bar left of the picture) -->
        <Style x:Key="RailButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <!-- header -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding PreviousCommand}" Margin="0,0,8,0" Padding="12,7">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72B;" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource Ann.Prev}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding RejectCommand}" Margin="0,0,8,0" Padding="12,7">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="12" Margin="0,0,8,0" Foreground="{StaticResource BadBrush}" />
                        <TextBlock Text="{DynamicResource Ann.Reject}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding SkipCommand}" Margin="0,0,8,0" Padding="12,7">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Ann.Skip}" />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72A;" FontSize="12" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding NewArtboardCommand}" Margin="0,0,8,0" Padding="10,7" ToolTip="{DynamicResource Board.New}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="13" />
                </Button>
                <Button Command="{Binding SaveCommand}" Style="{DynamicResource AccentButtonStyle}" Padding="16,7">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource Ann.Save}" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Text="{DynamicResource Nav.Annotate}" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
        </DockPanel>

        <Grid x:Name="Body">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition x:Name="PanelCol" Width="340" />
            </Grid.ColumnDefinitions>

            <!-- ============ tool bar: Save as vector, Pen tool, Brush ============ -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="5,8" CornerRadius="10" VerticalAlignment="Stretch" FlowDirection="LeftToRight">
                <StackPanel>
                    <Button Command="{Binding ExportPdfCommand}" ToolTip="{DynamicResource Pdf.Export}" Style="{StaticResource RailButton}">
                        <Grid>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="16" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="PDF" FontSize="6" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Grid>
                    </Button>
                    <Border Height="1" Margin="4,2,4,8" Background="{DynamicResource CardStrokeColorDefaultBrush}" />
                    <Button Command="{Binding UseSelectCommand}" ToolTip="{DynamicResource Tool.Select}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RailButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelectMode}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BrandSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <!-- the black arrow of Illustrator -->
                        <Path Data="M0,0 L0,15 L4,11.4 L6.8,17.6 L9.2,16.5 L6.5,10.5 L11.5,10.5 Z" Fill="{DynamicResource TextFillColorPrimaryBrush}" Width="12" Height="18" Stretch="Uniform" />
                    </Button>
                    <Button Command="{Binding UsePenCommand}" ToolTip="{DynamicResource Tool.PenSwitch}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RailButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDrawPen}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BrandSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Data="{StaticResource PenNibGeometry}" Fill="{DynamicResource TextFillColorPrimaryBrush}" Width="18" Height="18" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform><RotateTransform Angle="-45" /></Path.RenderTransform>
                        </Path>
                    </Button>
                    <Button Command="{Binding UseBrushCommand}" ToolTip="{DynamicResource Tool.BrushSwitch}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RailButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDrawBrush}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BrandSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Data="{StaticResource PaintBrushGeometry}" Fill="{DynamicResource TextFillColorPrimaryBrush}" Width="18" Height="18" Stretch="Uniform" />
                    </Button>
                    <Button Command="{Binding UseCurvatureCommand}" ToolTip="{DynamicResource Tool.Curvature}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RailButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCurvatureMode}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BrandSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <!-- a curve through points -->
                        <Canvas Width="20" Height="18">
                            <Path Data="M2,15 C5,3 14,3 18,13" Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.6" />
                            <Ellipse Canvas.Left="0" Canvas.Top="13" Width="4" Height="4" Fill="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Ellipse Canvas.Left="8" Canvas.Top="4" Width="4" Height="4" Fill="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Ellipse Canvas.Left="16" Canvas.Top="11" Width="4" Height="4" Fill="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Canvas>
                    </Button>
                    <Button Command="{Binding UseScissorsCommand}" ToolTip="{DynamicResource Tool.Scissors}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RailButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScissorsMode}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BrandSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8C6;" FontSize="16" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Button>
                    <Button Command="{Binding UseKnifeCommand}" ToolTip="{DynamicResource Tool.Knife}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RailButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsKnifeMode}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BrandSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <!-- a blade -->
                        <Path Data="M2,17 L13,3 C15,1 18,2 17,5 L6,18 Z M13,3 L16,6" Fill="{DynamicResource TextFillColorPrimaryBrush}" Width="15" Height="17" Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- ============ tabs (one per open piece, like Illustrator) above the picture ============ -->
            <DockPanel Grid.Column="2">
                <ScrollViewer x:Name="TabScroller" DockPanel.Dock="Top" FlowDirection="LeftToRight" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="OnTabsWheel" Margin="0,0,0,0" Visibility="{Binding NoTabs, Converter={StaticResource InverseBoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Tabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Tab" CornerRadius="8,8,0,0" Padding="12,6,6,7" Margin="0,0,2,0" Cursor="Hand" Background="Transparent"
                                        MouseDown="OnTabMouseDown" ToolTip="{Binding FileInfo}">
                                    <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                                        <TextBlock Text="{Binding Text}" FontWeight="SemiBold" FontSize="12.5" FlowDirection="RightToLeft" MaxWidth="180" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding IdText}" FontSize="11.5" Opacity="0.6" Margin="7,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ZoomText}" FontSize="11.5" Opacity="0.6" Margin="5,0,0,0" VerticalAlignment="Center" />
                                        <Grid Width="20" Height="20" Margin="6,0,0,0">
                                            <Ellipse x:Name="Dirty" Width="7" Height="7" Fill="{DynamicResource BrandBrush}" Visibility="Collapsed" ToolTip="{DynamicResource Tabs.Unsaved}" />
                                            <Button x:Name="Close" Click="OnTabClose" Padding="0" Width="20" Height="20" MinWidth="0" MinHeight="0" Visibility="Hidden"
                                                    Background="Transparent" BorderThickness="0" Focusable="False" ToolTip="{DynamicResource Tabs.Close}">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="9" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                        <Setter TargetName="Dirty" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter TargetName="Tab" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                        <Setter TargetName="Close" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <Trigger SourceName="Tab" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Close" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="Dirty" Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsActive}" Value="True" />
                                            <Condition Binding="{Binding IsDirty}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="Close" Property="Visibility" Value="Hidden" />
                                    </MultiDataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- ============ stage: the clean picture with the regions on top (always left-to-right) ============ -->
                <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True" FlowDirection="LeftToRight" CornerRadius="0,10,10,10"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                    <Grid>
                            <ScrollViewer x:Name="Scroller" ScrollChanged="OnScrolled" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                          PreviewMouseWheel="OnWheel" PreviewMouseDown="OnPanDown" PreviewMouseMove="OnPanMove" PreviewMouseUp="OnPanUp">
                                <Grid x:Name="Paper" Margin="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid.LayoutTransform>
                                        <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1" />
                                    </Grid.LayoutTransform>
                                    <Border Background="{StaticResource PaperBrush}">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.25" />
                                        </Border.Effect>
                                    </Border>
                                    <Image x:Name="Pic" Source="{Binding Image}" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" Opacity="{Binding PictureOpacityValue}" />
                                    <!-- artboard: the reference picture (moved / scaled / faded; never part of the data) -->
                                    <Canvas x:Name="RefLayer" IsHitTestVisible="False" ClipToBounds="True">
                                        <Image x:Name="RefPic" Source="{Binding Reference}" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" Opacity="{Binding RefOpacity}" />
                                        <Border x:Name="RefFrame" BorderBrush="#FF3B82F6" BorderThickness="2" Visibility="{Binding AdjustReference, Converter={StaticResource BoolToVis}}" />
                                    </Canvas>
                                    <Canvas x:Name="Overlay" Background="Transparent" Cursor="Pen" MouseLeftButtonDown="OnOverlayDown" MouseMove="OnOverlayMove" MouseLeftButtonUp="OnOverlayUp" MouseLeave="OnOverlayLeave"
                                            MouseRightButtonDown="OnOverlayRight" />
                                    <!-- what follows the mouse (the stroke being drawn, the nib, the rubber band): drawn alone, so nothing lags -->
                                    <Canvas x:Name="Live" IsHitTestVisible="False" />
                                </Grid>
                            </ScrollViewer>
                        <!-- rulers (Ctrl+R): drag a guide out of them -->
                        <Canvas x:Name="RulerTop" Height="18" VerticalAlignment="Top" Background="#F0242428" ClipToBounds="True" Cursor="SizeNS"
                                MouseLeftButtonDown="OnRulerDown" MouseMove="OnRulerMove" MouseLeftButtonUp="OnRulerUp" Tag="h"
                                Visibility="{Binding ShowRulers, Converter={StaticResource BoolToVis}}" />
                        <Canvas x:Name="RulerLeft" Width="18" HorizontalAlignment="Left" Background="#F0242428" ClipToBounds="True" Cursor="SizeWE"
                                MouseLeftButtonDown="OnRulerDown" MouseMove="OnRulerMove" MouseLeftButtonUp="OnRulerUp" Tag="v"
                                Visibility="{Binding ShowRulers, Converter={StaticResource BoolToVis}}" />


                        <!-- hint: a small yellow "!" (a soft pulse when the guidance changes); a click shows the guidance -->
                        <StackPanel Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top" Orientation="Horizontal"
                                    Visibility="{Binding Hint, Converter={StaticResource NonEmptyToVis}}">
                            <ToggleButton x:Name="HintToggle" Width="28" Height="28" Cursor="Hand" Focusable="False" VerticalAlignment="Top" ToolTip="{DynamicResource Hint.Show}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid Background="Transparent">
                                            <Ellipse x:Name="Halo" Fill="Transparent" />
                                            <TextBlock x:Name="Mark" Text="!" FontWeight="Bold" FontSize="21" Foreground="#FFFACC15" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0">
                                                <TextBlock.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.55" Color="Black" /></TextBlock.Effect>
                                            </TextBlock>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Halo" Property="Fill" Value="#26FACC15" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Halo" Property="Fill" Value="#33FACC15" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Border Margin="8,0,0,0" CornerRadius="8" Padding="12,8" MaxWidth="560" Background="#F21C1C1E" BorderBrush="#99FACC15" BorderThickness="1"
                                    Visibility="{Binding IsChecked, ElementName=HintToggle, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" Foreground="White" FontSize="12.5"
                                           FlowDirection="{Binding FlowDirection, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </Border>
                        </StackPanel>

                            <!-- toast -->
                            <Border Style="{StaticResource Card}" Padding="16,9" Margin="0,0,0,16" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                    BorderBrush="{StaticResource GoodBrush}" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                    Visibility="{Binding Toast, Converter={StaticResource NonEmptyToVis}}">
                                <TextBlock Text="{Binding Toast}" FlowDirection="{Binding FlowDirection, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </Border>

                            <!-- floating bar: zoom, fit, picture opacity, original — always readable over a white picture -->
                            <Border Margin="12" HorizontalAlignment="Left" VerticalAlignment="Bottom" CornerRadius="10" Padding="6"
                                    Background="#F21C1C1E" BorderBrush="#33FFFFFF" BorderThickness="1" TextElement.Foreground="White">
                                <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.35" /></Border.Effect>
                                <StackPanel Orientation="Horizontal">
                                    <Button Click="OnZoomIn" Padding="9,6" Margin="0,0,4,0" ToolTip="Ctrl +"><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Foreground="White" /></Button>
                                    <Button Click="OnZoomOut" Padding="9,6" Margin="0,0,4,0" ToolTip="Ctrl −"><TextBlock Style="{StaticResource Icon}" Text="&#xE738;" FontSize="12" Foreground="White" /></Button>
                                    <Button Click="OnZoomFit" Padding="9,6" Margin="0,0,10,0" ToolTip="Ctrl 0"><TextBlock Style="{StaticResource Icon}" Text="&#xE9A6;" FontSize="12" Foreground="White" /></Button>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE706;" FontSize="12" Margin="0,0,8,0" Foreground="White" ToolTip="{DynamicResource Pic.Opacity}" />
                                    <Slider Width="120" Minimum="5" Maximum="100" Value="{Binding PictureOpacity}" VerticalAlignment="Center" IsMoveToPointEnabled="True" Focusable="False"
                                            ToolTip="{DynamicResource Pic.Opacity}" />
                                    <TextBlock Text="{Binding PictureOpacity, StringFormat={}{0:0}%}" FontSize="11" Width="36" Margin="6,0,8,0" VerticalAlignment="Center" Foreground="White" />
                                    <Button Command="{Binding ToggleOriginalCommand}" Padding="9,6" ToolTip="{DynamicResource Ann.Original}">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xEB9F;" FontSize="12" Foreground="White" />
                                    </Button>
                                    <Border Width="1" Margin="8,4" Background="#44FFFFFF" />
                                    <!-- rulers (Ctrl+R), guides (Ctrl+;), snapping to the guides -->
                                    <ToggleButton IsChecked="{Binding ShowRulers}" Padding="8,6" Margin="0,0,4,0" Focusable="False" ToolTip="{DynamicResource Guides.Rulers}">
                                        <Path Data="M0,4 L16,4 L16,10 L0,10 Z M3,4 L3,7 M6,4 L6,8 M9,4 L9,7 M12,4 L12,8" Stroke="White" StrokeThickness="1.2" Width="16" Height="12" />
                                    </ToggleButton>
                                    <ToggleButton IsChecked="{Binding ShowGuides}" Padding="8,6" Margin="0,0,4,0" Focusable="False" ToolTip="{DynamicResource Guides.Show}">
                                        <Path Data="M0,4 L16,4 M0,11 L16,11 M5,0 L5,15 M12,0 L12,15" Stroke="#FF29B6F6" StrokeThickness="1.3" Width="16" Height="15" />
                                    </ToggleButton>
                                    <ToggleButton IsChecked="{Binding SnapToGuides}" Padding="8,6" Focusable="False" ToolTip="{DynamicResource Guides.Snap}">
                                        <Path Data="M2,1 L2,8 A5,5 0 0 0 12,8 L12,1 L9,1 L9,8 A2,2 0 0 1 5,8 L5,1 Z" Fill="White" Width="14" Height="14" Stretch="Uniform" />
                                    </ToggleButton>
                                </StackPanel>
                            </Border>

                            <!-- original -->
                            <Border Width="130" Margin="12,12,12,70" HorizontalAlignment="Right" VerticalAlignment="Bottom" CornerRadius="8" ClipToBounds="True" Padding="4"
                                    Background="{StaticResource PaperBrush}" BorderBrush="#66000000" BorderThickness="2"
                                    ToolTip="{DynamicResource Ann.Original}" Opacity="0.95"
                                    Visibility="{Binding ShowOriginal, Converter={StaticResource BoolToVis}}">
                                <Image Source="{Binding Original}" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>

                            <!-- nothing left -->
                            <TextBlock Text="{DynamicResource Ann.None}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding NothingLeft, Converter={StaticResource BoolToVis}}" />

                        <!-- Add to library: a folder of pieces into a style folder of the library -->
                        <Button Command="{Binding AddToLibraryCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,26,14,0" Padding="7"
                                Focusable="False" ToolTip="{DynamicResource Studio.AddToLib}" Background="#CC1C1C1E" BorderBrush="#44FFFFFF">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Foreground="White" />
                        </Button>

                        <!-- every tab closed -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding NoTabs, Converter={StaticResource BoolToVis}}"
                                    FlowDirection="{Binding FlowDirection, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <TextBlock Text="{DynamicResource Tabs.None}" FontSize="17" HorizontalAlignment="Center" />
                            <Button Command="{Binding OpenNextPieceCommand}" Style="{DynamicResource AccentButtonStyle}" Padding="16,7" Margin="0,14,0,0" HorizontalAlignment="Center">
                                <TextBlock Text="{DynamicResource Tabs.Next}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </DockPanel>

            <!-- ============ the panel's edge: drag to change its width (double-click: back to normal) ============ -->
            <Thumb x:Name="PanelThumb" Grid.Column="3" Cursor="SizeWE" DragDelta="OnPanelDrag" DragCompleted="OnPanelDragDone"
                   MouseDoubleClick="OnPanelReset" Focusable="False" ToolTip="{DynamicResource Panel.Resize}">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Border x:Name="Line" Width="2" CornerRadius="1" Background="{DynamicResource BrandBrush}" Opacity="0" Margin="0,40" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Line" Property="Opacity" Value="0.6" /></Trigger>
                            <Trigger Property="IsDragging" Value="True"><Setter TargetName="Line" Property="Opacity" Value="1" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <!-- ============ side panel ============ -->
            <ScrollViewer x:Name="PanelScroll" Grid.Column="4" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding IsArtboard, Converter={StaticResource BoolToVis}}">
                                    <Button Command="{Binding ToggleAdjustReferenceCommand}" Padding="8,4" Margin="0,0,6,0" ToolTip="{DynamicResource Board.Adjust}"
                                            Visibility="{Binding HasReference, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7C2;" FontSize="13" />
                                    </Button>
                                    <Button Command="{Binding AddReferenceCommand}" Padding="8,4" ToolTip="{DynamicResource Board.AddReference}">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8B9;" FontSize="13" />
                                    </Button>
                                </StackPanel>
                                <!-- folds the panel away (its width is dragged on its edge) -->
                                <Button x:Name="FoldPanel" DockPanel.Dock="Left" Click="OnFoldPanel" Padding="5,3" Margin="0,0,8,0" VerticalAlignment="Center"
                                        ToolTip="{DynamicResource Panel.Fold}" Focusable="False">
                                    <Path Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="8" Height="10">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Data" Value="M2,1 L6,5 L2,9" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding FlowDirection, RelativeSource={RelativeSource AncestorType=Window}}" Value="RightToLeft">
                                                        <Setter Property="Data" Value="M6,1 L2,5 L6,9" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Button>
                                <TextBlock Text="{DynamicResource Ann.Text}" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged, Delay=400}" FontSize="18" FontWeight="SemiBold"
                                     FlowDirection="RightToLeft" Padding="10,6" />
                            <TextBlock Text="{DynamicResource Ann.Fix}" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,6,0,0" />
                            <CheckBox IsChecked="{Binding IsTestSet}" Margin="0,10,0,0" Focusable="False">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Ann.TestSet}" FontSize="12.5" />
                                    <TextBlock Text="{DynamicResource Ann.TestSetS}" Style="{StaticResource Muted}" FontSize="11" />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Ann.Letters}" Style="{StaticResource SectionTitle}" />
                            <ItemsControl ItemsSource="{Binding Chips}" FlowDirection="RightToLeft">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.SelectChipCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                Template="{StaticResource BareButton}" Cursor="Hand" Margin="{Binding Gap}">
                                            <Grid Margin="0,0,7,7">
                                                <Border x:Name="Box" Width="54" CornerRadius="9" Padding="4,4,4,3" BorderThickness="1,1,1,3"
                                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderBrush="{Binding ColorBrush}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Letter}" FontSize="22" HorizontalAlignment="Center" />
                                                        <TextBlock Text="{Binding FormText}" FontSize="10" Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                                <Border x:Name="Ok" Width="17" Height="17" CornerRadius="9" Background="{StaticResource GoodBrush}"
                                                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-6,-6,0,0" Visibility="Collapsed">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="9" Foreground="White" HorizontalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                        </Button>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource BrandSoftBrush}" />
                                                <Setter TargetName="Box" Property="BorderThickness" Value="2,2,2,3" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                <Setter TargetName="Ok" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Ann.Tools}" Style="{StaticResource SectionTitle}" />
                            <ItemsControl ItemsSource="{Binding Tools}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.SetToolCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Key}"
                                                Template="{StaticResource BareButton}" Cursor="Hand" Margin="0,0,6,6">
                                            <Border x:Name="Box" CornerRadius="8" Padding="9,7" BorderThickness="1"
                                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Right" Style="{StaticResource Kbd}" Margin="6,0,0,0">
                                                        <TextBlock Text="{Binding Shortcut}" FontSize="10.5" Style="{StaticResource Muted}" />
                                                    </Border>
                                                    <Border Width="11" Height="11" CornerRadius="3" Background="{Binding Brush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </Border>
                                        </Button>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource BrandSoftBrush}" />
                                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BrandBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>


                    <!-- Brushes (like the Illustrator Brushes panel): list, double-click edits, + adds -->
                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10" Visibility="{Binding IsBrushTool, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Command="{Binding AddBrushCommand}" Padding="8,4" ToolTip="{DynamicResource Brushes.Add}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" />
                                </Button>
                                <TextBlock Text="{DynamicResource Brushes.Title}" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                            </DockPanel>
                            <ListBox x:Name="BrushListBox" ItemsSource="{Binding BrushList}" MaxHeight="230" FlowDirection="LeftToRight" HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="1"
                                     BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Focusable="False">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="Padding" Value="6,3" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="MinHeight" Value="0" />
                                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=OneWay}" />
                                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnBrushClick" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel ToolTip="{Binding Details}">
                                            <DockPanel.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{DynamicResource Brushes.Rename}" Click="OnBrushRenameMenu" InputGestureText="F2" />
                                                    <MenuItem Header="{DynamicResource Brushes.Edit}" Click="OnBrushEditMenu" />
                                                    <MenuItem Header="{DynamicResource Brushes.Duplicate}" Click="OnBrushDuplicateMenu" />
                                                </ContextMenu>
                                            </DockPanel.ContextMenu>
                                            <!-- nib icon (left) -->
                                            <Grid Width="26" Height="22" Margin="0,0,10,0">
                                                <Border BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" CornerRadius="3" />
                                                <Ellipse Width="17" Height="{Binding Roundness, Converter={StaticResource NibHeight}, ConverterParameter=17}"
                                                         Fill="{DynamicResource TextFillColorPrimaryBrush}" RenderTransformOrigin="0.5,0.5">
                                                    <Ellipse.RenderTransform>
                                                        <RotateTransform Angle="{Binding Angle, Converter={StaticResource Negate}}" />
                                                    </Ellipse.RenderTransform>
                                                </Ellipse>
                                            </Grid>
                                            <!-- angle (from the brush's settings, not its name) -->
                                            <TextBlock Text="{Binding AngleText}" FontSize="12" Width="38" VerticalAlignment="Center" Opacity="0.85" />
                                            <!-- name; a box in its place while renaming -->
                                            <Grid>
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding IsRenaming, Converter={StaticResource InverseBoolToVis}}" />
                                                <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" FontSize="12.5" Padding="4,1" MinHeight="0"
                                                         Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}"
                                                         KeyDown="OnRenameKey" LostFocus="OnRenameLost" IsVisibleChanged="OnRenameShown" />
                                            </Grid>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{DynamicResource Brushes.Hint}" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,8" />
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Brush.Size}" VerticalAlignment="Center" FontSize="12" />
                                <Slider Grid.Column="1" Minimum="2" Maximum="160" Value="{Binding BrushSize}" IsMoveToPointEnabled="True" Focusable="False" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding BrushSize, StringFormat={}{0:0}}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" FlowDirection="LeftToRight" />
                            </Grid>
                            <!-- StreamLine, like Procreate: live smoothing while drawing -->
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Brush.StreamLine}" VerticalAlignment="Center" FontSize="12" ToolTip="{DynamicResource Brush.StreamLineTip}" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding StreamLine}" IsMoveToPointEnabled="True" Focusable="False" VerticalAlignment="Center"
                                        ToolTip="{DynamicResource Brush.StreamLineTip}" />
                                <TextBlock Grid.Column="2" Text="{Binding StreamLine, StringFormat={}{0:0}%}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" FlowDirection="LeftToRight" />
                            </Grid>
                            <!-- Fidelity, like the Illustrator Paintbrush Tool Options -->
                            <TextBlock Text="{DynamicResource Brush.Fidelity}" FontSize="12" Margin="0,8,0,2" />
                            <Slider Minimum="0" Maximum="4" TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight" Value="{Binding Fidelity}"
                                    Focusable="False" FlowDirection="LeftToRight" />
                            <DockPanel FlowDirection="LeftToRight">
                                <TextBlock DockPanel.Dock="Right" Text="{DynamicResource Brush.Smooth}" Style="{StaticResource Muted}" FontSize="11" />
                                <TextBlock Text="{DynamicResource Brush.Accurate}" Style="{StaticResource Muted}" FontSize="11" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Command="{Binding ClearAllCommand}" Content="{DynamicResource Ann.Clear}" Padding="8,3" FontSize="12" />
                                <TextBlock Text="{DynamicResource Ann.Segs}" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Segments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="7" Padding="8,4" Margin="0,0,0,4" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Padding="4,2" Background="Transparent" BorderThickness="0"
                                                        Command="{Binding DataContext.DeleteSegmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="10" />
                                                </Button>
                                                <Border Width="10" Height="10" CornerRadius="3" Background="{Binding Brush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Label}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Ann.Keys}" Style="{StaticResource SectionTitle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Style="{StaticResource Kbd}"><TextBlock Text="Click / Drag" FontSize="11" /></Border>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{DynamicResource Key.Pen}" Style="{StaticResource Muted}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" />
                                <Border Grid.Row="1" Style="{StaticResource Kbd}"><TextBlock Text="Space" FontSize="11" /></Border>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{DynamicResource Key.Space}" Style="{StaticResource Muted}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" />
                                <Border Grid.Row="2" Style="{StaticResource Kbd}"><TextBlock Text="Enter" FontSize="11" /></Border>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{DynamicResource Key.Enter}" Style="{StaticResource Muted}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" />
                                <Border Grid.Row="3" Style="{StaticResource Kbd}"><TextBlock Text="Backspace" FontSize="11" /></Border>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{DynamicResource Key.Back}" Style="{StaticResource Muted}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" />
                                <Border Grid.Row="4" Style="{StaticResource Kbd}"><TextBlock Text="Ctrl+Z · Ctrl+Shift+Z" FontSize="11" /></Border>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{DynamicResource Key.Undo}" Style="{StaticResource Muted}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" />
                                <Border Grid.Row="5" Style="{StaticResource Kbd}"><TextBlock Text="Tab" FontSize="11" /></Border>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{DynamicResource Key.Tab}" Style="{StaticResource Muted}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" />
                                <Border Grid.Row="6" Style="{StaticResource Kbd}"><TextBlock Text="S" FontSize="11" /></Border>
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{DynamicResource Key.S}" Style="{StaticResource Muted}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" />
                                <Border Grid.Row="7" Style="{StaticResource Kbd}"><TextBlock Text="1 – 8" FontSize="11" /></Border>
                                <TextBlock Grid.Row="7" Grid.Column="1" Text="{DynamicResource Key.Num}" Style="{StaticResource Muted}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" />
                                <Border Grid.Row="10" Style="{StaticResource Kbd}"><TextBlock Text="Alt + Wheel" FontSize="11" /></Border>
                                <TextBlock Grid.Row="10" Grid.Column="1" Text="{DynamicResource Key.AltWheel}" Style="{StaticResource Muted}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" />
                                <Border Grid.Row="11" Style="{StaticResource Kbd}"><TextBlock Text="Alt + Drag" FontSize="11" /></Border>
                                <TextBlock Grid.Row="11" Grid.Column="1" Text="{DynamicResource Key.AltDrag}" Style="{StaticResource Muted}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" />
                                <Border Grid.Row="9" Style="{StaticResource Kbd}"><TextBlock Text="Shift" FontSize="11" /></Border>
                                <TextBlock Grid.Row="9" Grid.Column="1" Text="{DynamicResource Key.Shift}" Style="{StaticResource Muted}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" />
                                <Border Grid.Row="8" Style="{StaticResource Kbd}"><TextBlock Text="Ctrl+Wheel" FontSize="11" /></Border>
                                <TextBlock Grid.Row="8" Grid.Column="1" Text="{DynamicResource Key.Wheel}" Style="{StaticResource Muted}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" />
                                <Border Grid.Row="12" Style="{StaticResource Kbd}"><TextBlock Text="Ctrl + Click" FontSize="11" /></Border>
                                <TextBlock Grid.Row="12" Grid.Column="1" Text="{DynamicResource Key.CtrlClick}" Style="{StaticResource Muted}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Border Grid.Row="13" Style="{StaticResource Kbd}"><TextBlock Text="Delete" FontSize="11" /></Border>
                                <TextBlock Grid.Row="13" Grid.Column="1" Text="{DynamicResource Key.Delete}" Style="{StaticResource Muted}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Border Grid.Row="14" Style="{StaticResource Kbd}"><TextBlock Text="Ctrl+Tab · Ctrl+W" FontSize="11" /></Border>
                                <TextBlock Grid.Row="14" Grid.Column="1" Text="{DynamicResource Key.Tabs}" Style="{StaticResource Muted}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Border Grid.Row="15" Style="{StaticResource Kbd}"><TextBlock Text="Right click" FontSize="11" /></Border>
                                <TextBlock Grid.Row="15" Grid.Column="1" Text="{DynamicResource Key.RightClick}" Style="{StaticResource Muted}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Border Grid.Row="16" Style="{StaticResource Kbd}"><TextBlock Text="V" FontSize="11" /></Border>
                                <TextBlock Grid.Row="16" Grid.Column="1" Text="{DynamicResource Key.V}" Style="{StaticResource Muted}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Border Grid.Row="17" Style="{StaticResource Kbd}"><TextBlock Text="Shift + ~" FontSize="11" /></Border>
                                <TextBlock Grid.Row="17" Grid.Column="1" Text="{DynamicResource Key.Curvature}" Style="{StaticResource Muted}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Border Grid.Row="18" Style="{StaticResource Kbd}"><TextBlock Text="X + Wheel" FontSize="11" /></Border>
                                <TextBlock Grid.Row="18" Grid.Column="1" Text="{DynamicResource Key.XWheel}" Style="{StaticResource Muted}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Border Grid.Row="19" Style="{StaticResource Kbd}"><TextBlock Text="C · K" FontSize="11" /></Border>
                                <TextBlock Grid.Row="19" Grid.Column="1" Text="{DynamicResource Key.Cut}" Style="{StaticResource Muted}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Border Grid.Row="20" Style="{StaticResource Kbd}"><TextBlock Text="Ctrl + R" FontSize="11" /></Border>
                                <TextBlock Grid.Row="20" Grid.Column="1" Text="{DynamicResource Key.Rulers}" Style="{StaticResource Muted}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Border Grid.Row="21" Style="{StaticResource Kbd}"><TextBlock Text="Ctrl + ;" FontSize="11" /></Border>
                                <TextBlock Grid.Row="21" Grid.Column="1" Text="{DynamicResource Key.Guides}" Style="{StaticResource Muted}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <!-- folded: a slim bar with the arrow that opens it again -->
            <Border x:Name="PanelFolded" Grid.Column="4" Style="{StaticResource Card}" Padding="3,8" CornerRadius="10" Visibility="Collapsed" VerticalAlignment="Stretch">
                <Button Click="OnFoldPanel" Padding="5,4" VerticalAlignment="Top" HorizontalAlignment="Center" ToolTip="{DynamicResource Panel.Open}" Focusable="False">
                    <Path Data="M6,1 L2,5 L6,9" Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="8" Height="10" />
                </Button>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
