<Application x:Class="Neuraink.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:Neuraink.App.Services"
             ThemeMode="Dark"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/AppStyles.xaml" />
                <ResourceDictionary Source="Localization/Strings.ar.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <svc:InverseBoolConverter x:Key="InverseBool" />
            <svc:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
            <svc:EqualsConverter x:Key="Equals" />
            <svc:NonEmptyToVisibilityConverter x:Key="NonEmptyToVis" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
