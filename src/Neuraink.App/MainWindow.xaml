<Window x:Class="Neuraink.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Neuraink.App.ViewModels"
        xmlns:views="clr-namespace:Neuraink.App.Views"
        Title="NEURAINK"
        Icon="pack://application:,,,/NEURAINK;component/Assets/neuraink.ico"
        Width="1360" Height="840" MinWidth="1040" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LibraryViewModel}"><views:LibraryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AnnotateViewModel}"><views:AnnotateView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LettersViewModel}"><views:LettersView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- sidebar: folds to its icons (the arrow next to Dashboard); the names show as tooltips -->
        <Border Grid.Column="0" Background="{DynamicResource LayerFillColorAltBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="248" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding NavCollapsed}" Value="True">
                            <Setter Property="Width" Value="68" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel Margin="10,18,10,12" LastChildFill="True">
                <!-- NEURAINK brand: ink drop + name + tagline -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,4,22" FlowDirection="LeftToRight"
                            Visibility="{Binding NavCollapsed, Converter={StaticResource InverseBoolToVis}}">
                    <Image Source="pack://application:,,,/NEURAINK;component/Assets/neuraink.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="NEURAINK" FontWeight="Bold" FontSize="17" />
                        <TextBlock Text="{DynamicResource App.Tagline}" FontSize="10.5" Opacity="0.6" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>
                <!-- folded: the drop, then the arrow that opens the menu again -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14" Visibility="{Binding NavCollapsed, Converter={StaticResource BoolToVis}}">
                    <Image Source="pack://application:,,,/NEURAINK;component/Assets/neuraink.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Center" ToolTip="NEURAINK" />
                    <Button Command="{Binding ToggleNavCommand}" Padding="8,5" Margin="0,14,0,0" HorizontalAlignment="Center" Focusable="False"
                            ToolTip="{DynamicResource Nav.Expand}">
                        <!-- a drawn chevron: mirrored with the layout in Arabic -->
                        <Path Data="M2,1 L6,5 L2,9" Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="8" Height="10" />
                    </Button>
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom" Text="{Binding VersionText}" Style="{StaticResource Muted}" FontSize="11" Margin="8,8,0,0" FlowDirection="LeftToRight" HorizontalAlignment="Left"
                           Visibility="{Binding NavCollapsed, Converter={StaticResource InverseBoolToVis}}" />

                <ListBox ItemsSource="{Binding Nav}" SelectedItem="{Binding SelectedNav}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                            <Setter Property="ToolTip" Value="{x:Null}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.NavCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="ToolTip" Value="{Binding Title}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <!-- open: icon, name, count / Soon; the first row has the arrow that folds the menu -->
                                <DockPanel x:Name="Full" Margin="4,8,4,8">
                                    <Button x:Name="Fold" DockPanel.Dock="Right" Padding="5,2" Margin="6,0,0,0" VerticalAlignment="Center" Focusable="False" Visibility="Collapsed"
                                            Command="{Binding DataContext.ToggleNavCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Background="Transparent" BorderThickness="0" ToolTip="{DynamicResource Nav.Collapse}">
                                        <Path Data="M6,1 L2,5 L6,9" Stroke="{DynamicResource TextFillColorSecondaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="8" Height="10" />
                                    </Button>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" Padding="7,0"
                                            Visibility="{Binding IsSoon, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{DynamicResource Common.Soon}" FontSize="10.5" />
                                    </Border>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" FontSize="11" Opacity="0.6" VerticalAlignment="Center" Margin="8,0,0,0"
                                               FlowDirection="LeftToRight" />
                                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Margin="0,0,12,0" />
                                    <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <!-- folded: the icon only -->
                                <TextBlock x:Name="IconOnly" Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="16" HorizontalAlignment="Center" Margin="0,9" Visibility="Collapsed" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsFirst}" Value="True">
                                    <Setter TargetName="Fold" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DataContext.NavCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter TargetName="Full" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="IconOnly" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- page -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Margin="24,22,28,20" Focusable="False" />
    </Grid>
</Window>
